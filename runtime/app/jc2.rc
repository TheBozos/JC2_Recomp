// The game window's executable icon and version information (Windows). The icon: docs/branding/make_logo.py.
#include <winver.h>

1 ICON "jc2.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Jade Cocoon 2"
            VALUE "ProductName", "Jade Cocoon 2 (JC2_Recomp, a native PC port)"
            VALUE "InternalName", "jc2"
            VALUE "OriginalFilename", "jc2.exe"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
